{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard application chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "$ref": "#/definitions/name"
    },
    "fullnameOverride": {
      "$ref": "#/definitions/name"
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": {
              "$ref": "#/definitions/intOrPercent"
            },
            "maxUnavailable": {
              "$ref": "#/definitions/intOrPercent"
            }
          },
          "additionalProperties": false,
          "required": [
            "maxSurge",
            "maxUnavailable"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "RollingUpdate"
              }
            }
          },
          "then": {
            "required": [
              "rollingUpdate"
            ]
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy"
      ],
      "anyOf": [
        {
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "digest"
          ],
          "properties": {
            "digest": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "containerPort": {
      "$ref": "#/definitions/port"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "create",
        "name",
        "annotations",
        "automountServiceAccountToken"
      ]
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "tmpVolume": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sizeLimit": {
          "$ref": "#/definitions/quantity"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "sizeLimit"
      ]
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "not": {
          "required": [
            "value",
            "valueFrom"
          ]
        }
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "configMap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "envFrom": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "envFrom",
        "data"
      ]
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "startupProbe": {
      "$ref": "#/definitions/probe"
    },
    "readinessProbe": {
      "$ref": "#/definitions/probe"
    },
    "livenessProbe": {
      "$ref": "#/definitions/probe"
    },
    "lifecycle": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 15,
                "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
              },
              "port": {
                "$ref": "#/definitions/port"
              },
              "targetPort": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/port"
                  },
                  {
                    "const": "http"
                  }
                ]
              },
              "protocol": {
                "enum": [
                  "TCP",
                  "UDP",
                  "SCTP"
                ]
              },
              "appProtocol": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "port",
              "targetPort"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "type",
        "port",
        "annotations",
        "extraPorts"
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "$ref": "#/definitions/name"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "hosts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "behavior": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "behavior"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "targetCPUUtilizationPercentage"
                ],
                "properties": {
                  "targetCPUUtilizationPercentage": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "required": [
                  "targetMemoryUtilizationPercentage"
                ],
                "properties": {
                  "targetMemoryUtilizationPercentage": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "anyOf": [
            {
              "$ref": "#/definitions/intOrPercent"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "$ref": "#/definitions/intOrPercent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "minAvailable"
                ],
                "properties": {
                  "minAvailable": {
                    "$ref": "#/definitions/intOrPercent"
                  },
                  "maxUnavailable": {
                    "type": "null"
                  }
                }
              },
              {
                "required": [
                  "maxUnavailable"
                ],
                "properties": {
                  "maxUnavailable": {
                    "$ref": "#/definitions/intOrPercent"
                  },
                  "minAvailable": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "$ref": "#/definitions/name"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany"
            ]
          }
        },
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "subPath": {
          "type": "string"
        },
        "retain": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "mountPath",
        "subPath",
        "retain",
        "annotations"
      ]
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "port": {
          "type": "string",
          "maxLength": 15,
          "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
        },
        "scheme": {
          "enum": [
            "http",
            "https"
          ]
        },
        "honorLabels": {
          "type": "boolean"
        },
        "relabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricRelabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "labels",
        "port",
        "path",
        "interval",
        "scrapeTimeout",
        "scheme",
        "honorLabels",
        "relabelings",
        "metricRelabelings"
      ]
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "nameOverride",
    "fullnameOverride",
    "commonLabels",
    "replicaCount",
    "revisionHistoryLimit",
    "progressDeadlineSeconds",
    "terminationGracePeriodSeconds",
    "strategy",
    "image",
    "imagePullSecrets",
    "command",
    "args",
    "containerPort",
    "resources",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "securityContext",
    "tmpVolume",
    "env",
    "envFrom",
    "configMap",
    "extraVolumes",
    "extraVolumeMounts",
    "startupProbe",
    "readinessProbe",
    "livenessProbe",
    "lifecycle",
    "service",
    "ingress",
    "autoscaling",
    "pdb",
    "persistence",
    "serviceMonitor",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "priorityClassName"
  ],
  "definitions": {
    "quantity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[eE][+-]?[0-9]+|[numkKMGTPE]|[KMGTPE]i)?$"
        }
      ]
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "httpGet",
            "tcpSocket",
            "exec",
            "grpc"
          ]
        },
        "httpGet": {
          "type": [
            "object",
            "null"
          ]
        },
        "tcpSocket": {
          "type": [
            "object",
            "null"
          ]
        },
        "exec": {
          "type": [
            "object",
            "null"
          ]
        },
        "grpc": {
          "type": [
            "object",
            "null"
          ]
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "type": {
                "const": "httpGet"
              }
            }
          },
          "then": {
            "required": [
              "httpGet"
            ],
            "properties": {
              "httpGet": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "type": {
                "const": "tcpSocket"
              }
            }
          },
          "then": {
            "required": [
              "tcpSocket"
            ],
            "properties": {
              "tcpSocket": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "type": {
                "const": "exec"
              }
            }
          },
          "then": {
            "required": [
              "exec"
            ],
            "properties": {
              "exec": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              },
              "type": {
                "const": "grpc"
              }
            }
          },
          "then": {
            "required": [
              "grpc"
            ],
            "properties": {
              "grpc": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "intOrPercent": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(100|[0-9]{1,2})%$"
        }
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
